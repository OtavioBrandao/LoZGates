# Diagnostico
LOZGATES_LOG_LEVEL=INFO
LOZGATES_LOG_DIR=logs
LOZGATES_LOG_MAX_BYTES=2000000
LOZGATES_LOG_BACKUP_COUNT=5

# Dados locais (telemetria opt-in/opt-out e caches)
LOZGATES_DATA_DIR=data

# IA via API Groq/OpenAI-compatible
LOZGATES_AI_API_KEY=
# GROQ_API_KEY tambem e aceito como alternativa.
LOZGATES_AI_API_URL=https://api.groq.com/openai/v1/chat/completions
LOZGATES_AI_MODEL=openai/gpt-oss-120b
LOZGATES_AI_TIMEOUT=15

# Opcional: encaminha o desktop ao servico Docker em vez de expor a chave nele.
LOZGATES_AI_SERVICE_URL=

# Bind do servico opcional (usado dentro do container).
LOZGATES_AI_SERVICE_HOST=0.0.0.0
LOZGATES_AI_SERVICE_PORT=8000
